<Project>

  <!-- Shared settings for every .NET project in the repo. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Treat trim/AOT analyzer findings as build-breaking so an
         AOT-incompatible reference is caught early, not at publish.
         Test projects self-override IsAotCompatible=false in their own
         csproj (same convention as the sibling repos); nothing to exclude
         here. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Style rules in .editorconfig at :warning severity fail the build (via
         TreatWarningsAsErrors), so code style is enforced, not IDE-advisory. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Source-generate the options binder so IConfiguration.Get<T>()/Bind()
         work without reflection under NativeAOT. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- The framework's version, in one place (spec 028 R1/R2).

       It used to be thirteen places: every packable csproj under libs/ carried
       its own <Version>0.1.0</Version>, which is the shape that already went
       wrong once here with <Authors> ; ten copies said the retired org name for
       three days after the rename because nothing made them move together.
       PackageVersionTests bans a per-project <Version> for that reason.

       VersionPrefix lives in this file rather than in Directory.Build.targets
       beside the pack metadata, because it is unconditional: every project has a
       version, packable or not. The pack block over there is conditioned on
       IsPackable, which is set by each csproj and so is not answerable until
       after the csproj is imported.

       A RELEASE IS OPT-IN, and the direction is the point. IsReleaseBuild=true
       clears the suffix and produces the stable version; every other build
       produces X.Y.Z;dev. The other way round ; stable by default, suffixed when
       something marks the build as local ; makes an unmarked pack
       indistinguishable from a release, and a package that claims to be a
       release and is not is the one thing a feed must never receive. Only
       .github/workflows/publish.yml sets it, and only after checking the tag
       against VersionPrefix.

       (XML forbids a double hyphen inside a comment, as nuget.config also notes.
       Dashes are written as semicolons above.) -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(IsReleaseBuild)' != 'true'">dev</VersionSuffix>
  </PropertyGroup>

  <!-- Local checkout of JauntyQ (data-access source generator), referenced by
       project until JauntyQ ships on NuGet — same wiring as epass.io / reader.
       Two probes, not one. The first is the ordinary checkout: jauntyq as a
       SIBLING of this repository. The second is two levels deeper, which is where
       a .worktrees/<branch> checkout sits — and without it EVERY worktree build in
       this repository fails at restore, before a line of the branch's own code is
       compiled. Found on the 009 branch; justsmtp's NativeWebRoot probe has
       carried the same two-depth pair, for the same reason, since it was written.

       Both probes are relative to this repository and NAME NO PARENT DIRECTORY.
       They used to hard-code an ancestor literally called `extrode-legacy-org.com`, which
       broke twice in one move on 2026-08-26: the org directory was renamed to
       `extrode.com` AND jauntyq moved with it, so both probes pointed at a path
       that no longer existed and every local-checkout build needed
       -p:JauntyQRoot to work at all. A relative probe survives the next rename.
       JauntyQRootProbeTests pins it.

       Each probe is guarded by Exists() so the property is only assigned when the
       path is real: a bare assignment would set JauntyQRoot to a directory that
       does not exist and defeat EnsureJauntyQRoot below, whose whole job is to
       name the wrong root rather than let it fail later as CS0246.

       Override with -p:JauntyQRoot=... if your checkout lives elsewhere. -->
  <PropertyGroup>
    <JauntyQRoot Condition="'$(JauntyQRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\jauntyq')">$(MSBuildThisFileDirectory)..\jauntyq</JauntyQRoot>
    <JauntyQRoot Condition="'$(JauntyQRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\jauntyq')">$(MSBuildThisFileDirectory)..\..\..\jauntyq</JauntyQRoot>

    <!-- Neither probe matched. Assign the single-depth path anyway so
         EnsureJauntyQRoot reports a concrete path rather than an empty string —
         "not found at ''" tells a reader nothing about where it looked. -->
    <JauntyQRoot Condition="'$(JauntyQRoot)' == ''">$(MSBuildThisFileDirectory)..\jauntyq</JauntyQRoot>
  </PropertyGroup>

  <!-- Dual-mode JauntyQ resolution (mirrors justsmtp.com):
       - local checkout present => ProjectReference for co-development;
       - no checkout / CI => -p:JauntyQUsePackages=true pulls the pinned
         JauntyQ.* packages (versions in Directory.Packages.props).

       Package mode is opt-in ONLY. There used to be an auto-default here that
       set it when JauntyQRoot was empty. The probe just above assigns JauntyQRoot
       a path on every ordinary path, so the condition was all but dead — the one
       way left to reach it was an explicit global -p:JauntyQRoot= (empty), which
       a props file cannot reassign. That case now hits the fail-fast below, which
       is the intent. CI passes the flag explicitly (see
       .github/workflows/ci.yml), which is the only way package mode is ever
       reached — deleted rather than repaired, because a silent fallback to
       older pinned packages is worse than the fail-fast below. -->

  <!-- MSBuild only warns (MSB9008) and silently skips missing ProjectReferences,
       which turns an unresolved JauntyQRoot into downstream CS0246s. Fail fast —
       but only in checkout mode; package mode has no path to validate.

       Probe the generator csproj rather than the directory: an empty or
       partially-cloned jauntyq/ passes a bare Exists() and then fails as
       CS0246, which is the error this target exists to pre-empt. Sentinel-file
       probe, same as skeleton/Directory.Build.props. -->
  <Target Name="EnsureJauntyQRoot" BeforeTargets="BeforeBuild"
          Condition="'$(JauntyQUsePackages)' != 'true' and !Exists('$(JauntyQRoot)\src\JauntyQ.Generator\JauntyQ.Generator.csproj')">
    <Error Text="JauntyQ checkout not found at '$(JauntyQRoot)'. Pass -p:JauntyQRoot=&lt;path&gt; or build with -p:JauntyQUsePackages=true." />
  </Target>

</Project>
