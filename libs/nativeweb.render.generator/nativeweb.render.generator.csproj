<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build-time half of the render engine (spec 003 R10–R12): an incremental
       source generator that compiles templates/**/*.html (AdditionalFiles) into
       static render classes writing UTF-8 through nativeweb.render's
       TemplateWriter. Same wiring pattern as JauntyQ.Generator: netstandard2.0,
       referenced with OutputItemType="Analyzer" ReferenceOutputAssembly="false". -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>NativeWeb.Render.Generator</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008: analyzer release tracking files — not used, same call as JauntyQ. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <!-- netstandard2.0 has no AOT analyzers; the generator never ships in the app. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
