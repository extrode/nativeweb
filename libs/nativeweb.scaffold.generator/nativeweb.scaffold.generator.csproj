<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build-time half of the scaffolding feature (brainstorm 001 T1.3): an
       incremental source generator that turns a [Scaffold]-decorated model into a
       working CRUD route group plus the HTML for every view. Same wiring pattern
       as nativeweb.render.generator and JauntyQ.Generator: netstandard2.0,
       referenced with OutputItemType="Analyzer" ReferenceOutputAssembly="false". -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>NativeWeb.Scaffold.Generator</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NativeWeb.Scaffold.Generator</PackageId>
    <Version>0.1.0</Version>
    <Authors>extrode-legacy-org</Authors>
    <Description>NativeWeb framework: build-time CRUD scaffolding source generator.</Description>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
