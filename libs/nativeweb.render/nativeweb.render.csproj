<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runtime half of the compiled-template render engine (spec 003 R10/R41):
       TemplateWriter (UTF-8, encode-by-default), the Html raw-markup gate, and
       the IResult adapter. The build-time half is libs/nativeweb.render.generator. -->
  <PropertyGroup>
    <RootNamespace>NativeWeb.Render</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- IResult / HttpContext for the response adapter. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
