       IsAotCompatible and analyzer settings come from Directory.Build.props. -->

  <ItemGroup>
    <!-- ILoginLinkSender / ICodeSender abstractions and CodeChannel. -->
    <ProjectReference Include="..\epass.auth\epass.auth.csproj" />
  </ItemGroup>

