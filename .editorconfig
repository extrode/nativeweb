# EditorConfig — top-level for the NativeWeb repo.
root = true

# Defaults for every file.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C#
[*.cs]
indent_size = 4
# Namespaces without an extra nesting level.
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

# Project / build / config files.
[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

# Web assets (vendored htmx / Alpine, templates).
[*.{js,ts,css,html}]
indent_size = 2

# SQL kept as LF, 2-space.
[*.sql]
indent_size = 2
