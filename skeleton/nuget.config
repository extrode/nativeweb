<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for a stamped product.

  This file exists because central package management (ManagePackageVersionsCentrally
  in Directory.Build.props) turns "more than one source, incompletely mapped" into a
  hard error, and without a repo-level config the source list is whatever the machine
  happens to have registered. Measured 2026-08-17 on a stamped product with no
  nuget.config, on a developer machine carrying one extra feed:

    error NU1507: Warning As Error: There are 2 package sources defined in your
    configuration. When using central package management, please map your package
    sources with package source mapping ... nuget.org, jauntyq-github

  Five projects, before a single line was compiled. A GitHub runner has only
  nuget.org so it would not have shown this, which is exactly why it is worth
  pinning: the failure lands on whoever stamps the product, not on CI.

  Note for anyone editing this file: XML forbids a double hyphen inside a comment,
  so write dashes as commas or semicolons here.
-->
<configuration>

  <packageSources>
    <!-- Clear the machine-level sources so a restore resolves identically on a
         developer machine and on a runner. Without it the set depends on what the
         local SDK and Visual Studio installs happen to have registered. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- One source, so the mapping below is a single catch-all. It stays because
       central package management turns any second source added later, by a
       machine config or by hand, into NU1507 unless the mapping already exists.
       Every pin, Extrode.NativeWeb.* and Extrode.JauntyQ.* alike, is on nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
