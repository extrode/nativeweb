<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for a stamped product.

  This file exists because central package management (ManagePackageVersionsCentrally
  in Directory.Build.props) turns "more than one source, incompletely mapped" into a
  hard error, and without a repo-level config the source list is whatever the machine
  happens to have registered. Measured 2026-08-17 on a stamped product with no
  nuget.config, on a developer machine carrying one extra feed:

    error NU1507: Warning As Error: There are 2 package sources defined in your
    configuration. When using central package management, please map your package
    sources with package source mapping ... nuget.org, jauntyq-github

  Five projects, before a single line was compiled. A GitHub runner has only
  nuget.org so it would not have shown this, which is exactly why it is worth
  pinning: the failure lands on whoever stamps the product, not on CI.

  Note for anyone editing this file: XML forbids a double hyphen inside a comment,
  so write dashes as commas or semicolons here.
-->
<configuration>

  <packageSources>
    <!-- Clear the machine-level sources so a restore resolves identically on a
         developer machine and on a runner. Without it the set depends on what the
         local SDK and Visual Studio installs happen to have registered. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- The NativeWeb.* pins reach this source only in package mode, and only
         once those packages are published. JauntyQ no longer does: its pins are
         Extrode.JauntyQ.*, public on nuget.org since core 0.5.0. See the mapping below. Rename this source, or
         point it at your own registry, if the packages you consume live
         elsewhere. -->
    <add key="framework-github" value="https://nuget.pkg.github.com/extrode/index.json" protocolVersion="3" />
  </packageSources>

  <!-- No packageSourceCredentials section here, deliberately. GitHub Packages needs
       auth even to read, but a token belongs in the CI secret store, not in a
       committed file. .github/workflows/ci.yml credentials this source in each job
       that restores; since 2026-09-24 no default restore needs it (JauntyQ comes
       from nuget.org), so that step matters only for NativeWeb.* package mode.
       Any other package-mode build must supply its own credential the same way.

       To build in package mode LOCALLY, put the credential in your own user config,
       never here. Dashes doubled as ";;" below because this is an XML comment, so
       drop the semicolons when typing:

         gh auth refresh -h github.com -s read:packages
         dotnet nuget add source https://nuget.pkg.github.com/extrode/index.json
           ;;name framework-github ;;username <your-account>
           ;;password "$(gh auth token)"
           ;;configfile "$env:APPDATA\NuGet\NuGet.Config"

       A gh OAuth token (gho_) is accepted by the NuGet registry, so no classic PAT
       is needed. On Windows the password is stored DPAPI encrypted, so the file
       holds no readable token and does not travel to another machine. -->

  <!-- Source mapping does two jobs. It stops a NativeWeb.* or JauntyQ.* id from
       ever being resolved off nuget.org, where a same-named package would be
       someone else's code; and because a source is only queried for ids that map
       to it, it keeps an ordinary checkout-mode restore from touching the
       authenticated source at all. That is what lets this file be committed
       without a token being needed for anything but the framework feed's own ids.
       JauntyQ resolves from packages by default, but its pins are
       Extrode.JauntyQ.* on nuget.org, so an ordinary restore needs no token;
       the JauntyQ.* patterns stay to keep that prefix off nuget.org.

       Mapping is all or nothing: once this section exists, an id matching no
       pattern fails to resolve. Hence the "*" catch-all. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="framework-github">
      <package pattern="NativeWeb.*" />
      <package pattern="JauntyQ.*" />
      <!-- The dotless ids as well. "NativeWeb.*" does not match a package called
           exactly "NativeWeb", so without these two lines such an id would match
           only the "*" catch-all and resolve from nuget.org, which is the
           dependency-confusion window this whole section exists to close. Neither
           id is published today; they are claimed here so that publishing one
           later cannot quietly open it. -->
      <package pattern="NativeWeb" />
      <package pattern="JauntyQ" />
      <!-- The premium half of JauntyQ (github.com/extrode/jauntyq-premium) publishes
           these two ids to the same private feed. Exact ids, not Extrode.JauntyQ.*:
           the core Extrode.JauntyQ.* packages live on nuget.org since core v0.5.0,
           and an exact id outranks any prefix pattern, so only these two leave the
           "*" catch-all. -->
      <package pattern="Extrode.JauntyQ.Cli.Premium" />
      <package pattern="Extrode.JauntyQ.Schema.Contract" />
    </packageSource>
  </packageSourceMapping>

</configuration>
