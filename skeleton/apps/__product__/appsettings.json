{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "__PRODUCT__": {
    "Db": {
      // Empty here on purpose: local dev supplies it via user-secrets, CI and
      // production as an environment variable. With no value the app still
      // boots, /readyz reports not-ready, and DB-backed routes 503.
      "ConnectionString": "",
      "CommandTimeoutSeconds": 30,
      // Set to 0 behind a transaction-pooling PgBouncer.
      "MaxAutoPrepare": 20
    },
    "RateLimit": {
      "General": { "PermitLimit": 120 },
      "CspReport": { "PermitLimit": 10 }
    },
    "BotTraps": {
      "MinAgeSeconds": 3
    },
    "Telemetry": {
      "Enabled": false
    },
    "DataProtection": {
      // Empty = keys persist under the user profile (~/.__product__/keys).
      // Production overrides this: the systemd unit's ProtectHome makes the
      // profile unreachable, so deploy/__product__.service points it at
      // /var/lib/__product__/keys.
      "KeyDirectory": ""
    },
    "ForwardedHeaders": {
      // Comma-separated proxy/LB addresses. Empty = forwarded headers are
      // ignored and every client shares one rate-limit partition.
      "KnownProxies": ""
    }
  }
}
