{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "__PRODUCT__": {
    "Db": {
      // Empty here on purpose: local dev supplies it via user-secrets, CI and
      // production as an environment variable. With no value the app still
      // boots, /readyz reports not-ready, and DB-backed routes 503.
      "ConnectionString": "",
      "CommandTimeoutSeconds": 30,
      // Set to 0 behind a transaction-pooling PgBouncer.
      "MaxAutoPrepare": 20
    },
    "RateLimit": {
      "General": { "PermitLimit": 120 },
      "CspReport": { "PermitLimit": 10 }
    },
    "BotTraps": {
      "MinAgeSeconds": 3
    },
    "Telemetry": {
      "Enabled": false
    },
    "SignIn": {
      // Empty AuthorizationEndpoint means no provider is configured, and the app
      // boots with no authentication scheme at all. Fill these four in and the
      // scheme registers itself; a protected route then challenges instead of
      // answering 401. Endpoint URLs come from the provider's discovery document.
      "AuthorizationEndpoint": "",
      "TokenEndpoint": "",
      "UserInfoEndpoint": "",
      "IntrospectionEndpoint": "",
      "ClientId": "",
      // Empty here on purpose, like the connection string: local dev supplies it
      // via user-secrets, production as an environment variable.
      "ClientSecret": "",
      "RedirectUri": "",
      // Base64 of 32 random bytes, protecting the provider tokens at rest in the
      // session store. Supplied the same way as ClientSecret, and rotating it signs
      // every session out. Generate with RandomNumberGenerator.GetBytes(32).
      "StoreEncryptionKey": ""
    },
    "DataProtection": {
      // Empty = keys persist under the user profile (~/.__product__/keys).
      // Production overrides this: the systemd unit's ProtectHome makes the
      // profile unreachable, so deploy/__product__.service points it at
      // /var/lib/__product__/keys.
      "KeyDirectory": ""
    },
    "ForwardedHeaders": {
      // Comma-separated proxy/LB addresses. Empty = forwarded headers are
      // ignored and every client shares one rate-limit partition.
      "KnownProxies": ""
    }
  }
}
