<Project>

  <!-- Shared settings for every .NET project in the repo. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Treat trim/AOT analyzer findings as build-breaking so an
         AOT-incompatible reference is caught early, not at publish.
         Test projects self-override IsAotCompatible=false in their own
         csproj (same convention as the sibling repos); nothing to exclude
         here. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Style rules in .editorconfig at :warning severity fail the build (via
         TreatWarningsAsErrors), so code style is enforced, not IDE-advisory. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Source-generate the options binder so IConfiguration.Get<T>()/Bind()
         work without reflection under NativeAOT. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Local checkout of JauntyQ (data-access source generator), referenced by
       project until JauntyQ ships on NuGet.
       Probed as a SIBLING of the stamped product, exactly like NativeWebRoot
       below, and naming no parent directory. It used to hard-code an ancestor
       by name; that broke on 2026-08-26 when the org directory was renamed and
       jauntyq moved with it, and a stamped product would have inherited the same
       break. Relative probes survive the next rename.

       Two probes, both guarded, for the reason the framework repo's own copy
       gives: a build from `.worktrees/<branch>` sits three directories deeper, so
       a single sibling probe resolves to a path that does not exist and every
       restore fails. The NativeWebRoot block below was already written this way;
       this one was not, and a stamped product adopting the same worktree layout
       would have inherited the break. Found in the 2026-08-30 audit sweep.
       Override with -p:JauntyQRoot=... if your checkout lives elsewhere. -->
  <PropertyGroup>
    <JauntyQRoot Condition="'$(JauntyQRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\jauntyq')">$(MSBuildThisFileDirectory)..\jauntyq</JauntyQRoot>
    <JauntyQRoot Condition="'$(JauntyQRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\jauntyq')">$(MSBuildThisFileDirectory)..\..\..\jauntyq</JauntyQRoot>

    <!-- Neither probe matched. Assign the single-depth path anyway, so whatever
         reports the failure names a concrete path rather than an empty string. -->
    <JauntyQRoot Condition="'$(JauntyQRoot)' == ''">$(MSBuildThisFileDirectory)..\jauntyq</JauntyQRoot>
  </PropertyGroup>

  <!-- Dual-mode JauntyQ resolution:
       - the default => the pinned JauntyQ.* packages (versions in
         Directory.Packages.props);
       - -p:JauntyQUsePackages=false => ProjectReference into a local checkout.

       Checkout mode is the opt-in, and it was the default until 2026-09-05.
       JauntyQ split its generator and runtime out to a public core repository,
       so a sibling jauntyq/ no longer carries the two csproj paths referenced
       below and a stamped product could not build at all without the flag. The
       package IDs did not change, so package mode is the path that kept working
       (core 0.5.0 renamed them later, to Extrode.JauntyQ.*).
       The framework repository made the same flip in the same change; its
       Directory.Build.props carries the full reasoning.

       NativeWebUsePackages below is NOT flipped with it: the NativeWeb.*
       packages have never been published, so a stamped product still needs the
       framework checkout. -->
  <PropertyGroup>
    <JauntyQUsePackages Condition="'$(JauntyQUsePackages)' == ''">true</JauntyQUsePackages>
  </PropertyGroup>

  <!-- MSBuild only warns (MSB9008) and silently skips missing ProjectReferences,
       which turns an unresolved JauntyQRoot into downstream CS0246s. Fail fast —
       but only in checkout mode; package mode has no path to validate. The probe
       is a sentinel csproj, not the bare directory: an empty or unrelated dir
       at the path would pass Exists() and still MSB9008-skip every reference.

       The sentinel names the public core's layout, the same path the
       framework's copy verified on 2026-09-24. -->
  <Target Name="EnsureJauntyQRoot" BeforeTargets="BeforeBuild"
          Condition="'$(JauntyQUsePackages)' == 'false' and !Exists('$(JauntyQRoot)\src\Extrode.JauntyQ.Generator\Extrode.JauntyQ.Generator.csproj')">
    <Error Text="JauntyQ checkout not found at '$(JauntyQRoot)'. Pass -p:JauntyQRoot=&lt;path&gt;, or drop -p:JauntyQUsePackages=false to build against the pinned packages." />
  </Target>

  <!-- Local checkout of NativeWeb (the framework libs: security, auth, render
       + render generator), referenced by project until the NativeWeb.* packages
       publish. Single-depth probe: a stamped product repo sits beside its
       framework, so the sibling resolves one level up. Override with
       -p:NativeWebRoot=... if your checkout lives elsewhere.

       BOTH CASINGS ARE PROBED, and that is not belt-and-braces. The framework
       repository is `nativeweb` on disk, but docs/getting-started.md tells you
       to `git clone <repo> NativeWeb` and the README's layout diagram draws it
       that way, so both spellings are in the wild, and a stamped product
       inherits whichever its author happened to use. On Windows either probe
       matches either directory and the bug is invisible; on Linux, where the
       skeleton's own CI runs, exactly one of them resolves. Lowercase is tried
       first because that is what the repository actually is. -->
  <PropertyGroup>
    <NativeWebRoot Condition="'$(NativeWebRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\nativeweb')">$(MSBuildThisFileDirectory)..\nativeweb</NativeWebRoot>
    <NativeWebRoot Condition="'$(NativeWebRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\NativeWeb')">$(MSBuildThisFileDirectory)..\NativeWeb</NativeWebRoot>
    <NativeWebRoot Condition="'$(NativeWebRoot)' == ''">$(MSBuildThisFileDirectory)..\nativeweb</NativeWebRoot>
  </PropertyGroup>

  <!-- Dual-mode NativeWeb resolution, same split as JauntyQ above:
       - local checkout (the default) => ProjectReference for co-development;
       - -p:NativeWebUsePackages=true => the pinned NativeWeb.* packages
         (versions in Directory.Packages.props).
       Package mode is opt-in ONLY, same as JauntyQ; MSBuild also reads bare
       environment variables as properties, so an ambient NativeWebUsePackages
       flips the mode silently — the message below makes the resolved mode
       visible in every build log. -->

  <!-- Same MSB9008 trap as JauntyQ: an unresolved NativeWebRoot silently drops
       the ProjectReferences and surfaces as downstream CS0246s. Fail fast —
       but only in checkout mode; package mode has no path to validate. Sentinel
       csproj probe for the same reason as EnsureJauntyQRoot. -->
  <Target Name="EnsureNativeWebRoot" BeforeTargets="BeforeBuild"
          Condition="'$(NativeWebUsePackages)' != 'true' and !Exists('$(NativeWebRoot)\libs\nativeweb.render\nativeweb.render.csproj')">
    <Error Text="NativeWeb checkout not found at '$(NativeWebRoot)'. Pass -p:NativeWebRoot=&lt;path&gt; or build with -p:NativeWebUsePackages=true." />
  </Target>

  <Target Name="ReportFrameworkResolution" BeforeTargets="BeforeBuild">
    <Message Importance="high" Condition="'$(NativeWebUsePackages)' != 'true'"
             Text="NativeWeb: checkout mode ($(NativeWebRoot))" />
    <Message Importance="high" Condition="'$(NativeWebUsePackages)' == 'true'"
             Text="NativeWeb: PACKAGE mode (pinned NativeWeb.* packages, not a checkout)" />
    <Message Importance="high" Condition="'$(JauntyQUsePackages)' != 'false'"
             Text="JauntyQ: PACKAGE mode (pinned JauntyQ.* packages, not a checkout)" />
    <Message Importance="high" Condition="'$(JauntyQUsePackages)' == 'false'"
             Text="JauntyQ: checkout mode ($(JauntyQRoot))" />
  </Target>

</Project>
