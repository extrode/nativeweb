<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, ImplicitUsings, InvariantGlobalization,
       IsAotCompatible and analyzer settings come from Directory.Build.props.

       This product's JauntyQ generator host: it globs db/queries/** and the
       committed schema snapshot under db/schema/, and emits the typed query
       and auto-CRUD accessors the app references. It compiles with zero
       queries; the generator simply emits nothing until db/queries/ has
       .sql files in it. -->

  <ItemGroup>
    <!-- The JauntyQ-generated code constructs Npgsql types directly. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <!-- JauntyQ: source generator (as analyzer) + runtime. The pinned NuGet packages
       are the default; a local checkout via ProjectReference is the opt-in for
       co-development (-p:JauntyQUsePackages=false), and it needs the post-split
       public core repository (github.com/extrode/jauntyq). CI takes the default and
       restores from nuget.org instead of cloning anything. If you do clone for
       co-development, put it BESIDE this repository, never inside it: nested, this
       repo's Directory.Packages.props reaches it and central package management
       fails its restore (NU1008). -->
  <ItemGroup Condition="'$(JauntyQUsePackages)' == 'false'">
    <ProjectReference Include="$(JauntyQRoot)\src\Extrode.JauntyQ.Generator\Extrode.JauntyQ.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="$(JauntyQRoot)\src\Extrode.JauntyQ.Runtime\Extrode.JauntyQ.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(JauntyQUsePackages)' != 'false'">
    <!-- The package ships under analyzers/dotnet/cs; OutputItemType /
         ReferenceOutputAssembly are ProjectReference metadata and would be
         ignored here. PrivateAssets keeps the generator build-only. -->
    <PackageReference Include="Extrode.JauntyQ.Generator" PrivateAssets="all" />
    <PackageReference Include="Extrode.JauntyQ.Runtime" />
  </ItemGroup>

  <!-- Inline SQL and the committed schema snapshot the generator reads. -->
  <ItemGroup>
    <AdditionalFiles Include="..\..\db\queries\**\*.sql" />
    <AdditionalFiles Include="..\..\db\schema\*.schema.json" />
  </ItemGroup>

</Project>
