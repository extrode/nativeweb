<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The scaffolding demo (brainstorm 001 T1.3). Two decorated models, no
       hand-written CRUD code, no templates: everything under /admin is emitted by
       libs/nativeweb.scaffold.generator at build time.

       TargetFramework, Nullable, ImplicitUsings, IsAotCompatible and
       TreatWarningsAsErrors come from Directory.Build.props. -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
    <RootNamespace>NativeWeb.Sample</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Declarative form binding (spec 014). The generator is referenced with
         ReferenceOutputAssembly="false" like every other one here: its types are a
         build-time concern and must not reach the published binary. -->
    <ProjectReference Include="..\..\libs\nativeweb.forms\nativeweb.forms.csproj" />
    <ProjectReference Include="..\..\libs\nativeweb.forms.generator\nativeweb.forms.generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\libs\nativeweb.scaffold\nativeweb.scaffold.csproj" />
    <ProjectReference Include="..\..\libs\nativeweb.scaffold.generator\nativeweb.scaffold.generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- JauntyQ, hosted here rather than taken from libs/nativeweb.data. That
       library generates against db/schema/jaunty.schema.json, which is epass.io's
       identity schema; the demo's articles table has no business in it. Hosting
       the generator locally against db/sample/ is also the more honest
       demonstration, because it is what a consumer stamping this template does. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup Condition="'$(JauntyQUsePackages)' != 'true'">
    <ProjectReference Include="$(JauntyQRoot)\src\JauntyQ.Generator\JauntyQ.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="$(JauntyQRoot)\src\JauntyQ.Runtime\JauntyQ.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(JauntyQUsePackages)' == 'true'">
    <PackageReference Include="JauntyQ.Generator" PrivateAssets="all" />
    <PackageReference Include="JauntyQ.Runtime" />
  </ItemGroup>

  <!-- The store's pure helpers are internal because nothing outside this app has
       any business calling them; the unit tier is the exception the attribute
       exists for. -->
  <ItemGroup>
    <InternalsVisibleTo Include="nativeweb.sample.tests.unit" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\db\sample\queries\**\*.sql" />
    <AdditionalFiles Include="..\..\db\sample\schema\*.schema.json" />
  </ItemGroup>

</Project>
