# .NET
bin/
obj/
*.user
artifacts/
*.binlog
*.pdb

# NativeAOT / publish build output.
# Sibling justsmtp.com deliberately COMMITS a top-level publish/ (vendored
# JauntyQ.Runtime artifacts), so we do NOT blanket-ignore publish/. Ignore only
# per-project publish output under bin/ and app publish dirs.
**/bin/publish/
apps/**/publish/

# Env / secrets
.env
.env.*
!.env.example
appsettings.*.local.json
*.pfx
*.key
secrets/

# Node / Playwright / npm (vendoring + e2e).
node_modules/
dist/
playwright-report/
test-results/

# Test / coverage
[Tt]est[Rr]esults/
coverage/
*.trx

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vs/
*.swp

# Local agent tooling (not committed, matches sibling repos)
.claude/
.specify/
.worktrees/

# Scratch: probes, dumps, diffs, throwaway publishes. Repo-local by rule so it is
# never shared with another project; never committed.
tmp/

# The AOT probe is a web-SDK project, so the SDK writes it a launchSettings.json
# on build with a randomly assigned port. Nothing launches it -- it exists to be
# published and have its warnings counted -- so the file is machine noise, and
# committing it would put one machine's port in everyone's diff. The real apps'
# launch settings (apps/web, apps/sample) stay tracked; this is scoped to the probe.
tests/nativeweb.signin.epass.tests.aot/Properties/
