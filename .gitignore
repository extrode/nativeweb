# .NET
bin/
obj/
*.user
artifacts/
*.binlog
*.pdb

# NativeAOT / publish build output.
# publish/ is not blanket-ignored; only per-project publish output under bin/ and
# the apps' publish dirs.
**/bin/publish/
apps/**/publish/

# Env / secrets
.env
.env.*
!.env.example
appsettings.*.local.json
*.pfx
*.key
secrets/

# Node / Playwright / npm (vendoring + e2e).
node_modules/
dist/
playwright-report/
test-results/

# Test / coverage
[Tt]est[Rr]esults/
coverage/
*.trx

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vs/
*.swp

# Local agent tooling (not committed)
.claude/
.specify/
.worktrees/

# Scratch: probes, dumps, diffs, throwaway publishes. Repo-local by rule so it is
# never shared with another project; never committed.
tmp/

# The AOT probe is a web-SDK project, so the SDK writes it a launchSettings.json
# on build with a randomly assigned port. Nothing launches it -- it exists to be
# published and have its warnings counted -- so the file is machine noise, and
# committing it would put one machine's port in everyone's diff. The real apps'
# launch settings (apps/sample) stay tracked; this is scoped to the probe.
tests/nativeweb.signin.tests.aot/Properties/

# A code-review artifact hub written by a per-machine tool outside this repo. It renders the
# gitignored reviews under tmp/ and drops its index and theme into docs/, which is otherwise the
# markdown source the docs site is built from. docs-site/ is this repo's documentation output;
# this is one machine's scratch viewer and does not belong in the tree.
docs/index.html
docs/assets/
