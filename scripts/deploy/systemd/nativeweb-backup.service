# Nightly database backup. Spec 011 T11 (R13).
[Unit]
Description=NativeWeb encrypted offsite database backup
Documentation=file:///opt/nativeweb/scripts/backup.sh
After=network-online.target postgresql.service
Wants=network-online.target

# A failed backup raises an alert rather than a log line nobody reads. This
# covers the run-and-fail case; a backup that never runs at all is covered by
# the success heartbeat inside backup.sh, because systemd cannot alert on the
# absence of its own invocation.
OnFailure=nativeweb-backup-failed.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/nativeweb/scripts/backup.sh --execute

# Long enough for a slow upload on a bad night, short enough that a hung
# connection does not sit there until the next timer fires and overlaps.
TimeoutStartSec=3600

Nice=10
IOSchedulingClass=idle
