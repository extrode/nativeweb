# Spec 011 T11 (R13).
[Unit]
Description=Nightly NativeWeb database backup

[Timer]
# 03:17 rather than 03:00. Every scheduled job on every host defaults to the
# hour, so the hour is when the object store, the network and this box are all
# busiest -- and it is when a provider's own maintenance lands.
OnCalendar=*-*-* 03:17:00
RandomizedDelaySec=15m

# A host that was powered off overnight runs the backup when it comes back,
# rather than skipping a day silently. Without this, a reboot window is an
# invisible gap in the retention chain.
Persistent=true

[Install]
WantedBy=timers.target
