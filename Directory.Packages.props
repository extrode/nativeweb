<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Central package versions. Add PackageReference in csproj without Version.
       Pins follow the shared .NET toolchain. -->
  <ItemGroup>
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- libsodium wrapper (span-based, AOT-friendly): CSPRNG + hashing for
         secret/ticket material. -->
    <PackageVersion Include="Geralt" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- Trimmed MimeKit/MailKit forks (no legacy charset tables), used by
         libs/nativeweb.mail for SMTP send + templating. Pins mirror epass.io. -->
    <PackageVersion Include="MailKitLite" Version="4.17.0" />
    <PackageVersion Include="MimeKitLite" Version="4.17.0" />
    <!-- JauntyQ pin: used only when building without a local jauntyq checkout
         (package mode, e.g. CI, -p:JauntyQUsePackages=true). Bump deliberately
         after a new jauntyq v* tag publishes. -->
    <PackageVersion Include="JauntyQ.Generator" Version="0.2.0" />
    <PackageVersion Include="JauntyQ.Runtime" Version="0.2.0" />
    <!-- WebAuthn/FIDO2 attestation+assertion verification (passkeys). Verified
         NativeAOT-clean via a standalone publish spike (TreatWarningsAsErrors +
         trim/AOT analyzers, zero warnings; native .exe runs incl. NSec/libsodium
         interop). Fido2.AspNet's AddFido2() DI helper is intentionally not used
         (see apps/web Program.cs) so Fido2.Models is the only transitive pull. -->
    <PackageVersion Include="Fido2" Version="4.0.1" />
    <!-- Fido2 4.0.1 floats a minimum on NSec.Cryptography 25.4.0 (libsodium
         [1.0.20.1, 1.0.21)), which conflicts with Geralt's exact libsodium
         [1.0.22, 1.0.23) pin (NU1107). NSec.Cryptography 26.4.0 moved to the same
         [1.0.22, 1.0.23) libsodium range, so pinning it here directly resolves
         both to the one native asset. Bump only after checking NSec's libsodium
         range still matches Geralt's. -->
    <PackageVersion Include="NSec.Cryptography" Version="26.4.0" />
    <!-- Telemetry (spec 003 R33): metrics + traces, exported over OTLP, gated
         behind NativeWeb:Telemetry:Enabled=false. All four move in
         lockstep; bump together. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

  <!-- Roslyn, for libs/nativeweb.render.generator (netstandard2.0 analyzer).
       Pins mirror JauntyQ.Generator (same machine, same SDK, proven in its CI). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>

  <!-- Test-only packages. Referenced solely by tests/*, never by shipping code. -->
  <ItemGroup>
    <!-- R13 well-formedness gate: strict-mode HTML parsing of rendered template
         output in the render engine's unit tests. -->
    <PackageVersion Include="AngleSharp" Version="1.6.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Integration tests: WebApplicationFactory host. Matched to the AspNetCore
         10.0.x line (no sibling pin exists to mirror). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
    <!-- End-to-end browser tests. Net-new to this repo (no sibling reference);
         pinned to a recent 1.x. -->
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.12.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.49.0" />
  </ItemGroup>

</Project>
