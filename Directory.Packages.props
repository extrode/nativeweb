<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Central package versions. Add PackageReference in csproj without Version.
       Pins follow the shared .NET toolchain. -->
  <ItemGroup>
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- libsodium wrapper (span-based, AOT-friendly): CSPRNG + hashing for
         secret/ticket material. -->
    <PackageVersion Include="Geralt" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- Trimmed MimeKit/MailKit forks (no legacy charset tables), used by
         libs/nativeweb.mail for SMTP send + templating. Pins mirror epass.io. -->
    <PackageVersion Include="MailKitLite" Version="4.17.0" />
    <PackageVersion Include="MimeKitLite" Version="4.17.0" />
    <!-- JauntyQ pin: used only when building without a local jauntyq checkout
         (package mode, e.g. CI, -p:JauntyQUsePackages=true). Bump deliberately
         after a new jauntyq v* tag publishes. -->
    <PackageVersion Include="JauntyQ.Generator" Version="0.4.0" />
    <PackageVersion Include="JauntyQ.Runtime" Version="0.4.0" />
    <!-- Fido2 4.0.1 and NSec.Cryptography 26.4.0 were pinned here and were removed
         on 2026-08-31: WebAuthn left with the identity provider
         (docs/decisions/2026-08-31-007-idp-leaves-nativeweb.md) and neither had a
         PackageReference anywhere afterwards. Anything reintroducing Fido2 needs the
         NSec pin back with it: Fido2 floats a minimum on NSec 25.4.0, whose libsodium
         range [1.0.20.1, 1.0.21) conflicts with Geralt's exact [1.0.22, 1.0.23) pin
         and fails restore with NU1107. NSec 26.4.0 shares Geralt's range, which is what
         resolved both to one native asset. -->
    <!-- Telemetry (spec 003 R33): metrics + traces, exported over OTLP, gated
         behind NativeWeb:Telemetry:Enabled=false. All four move in
         lockstep; bump together. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

  <!-- Roslyn, for libs/nativeweb.render.generator (netstandard2.0 analyzer).
       Pins mirror JauntyQ.Generator (same machine, same SDK, proven in its CI). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>

  <!-- Test-only packages. Referenced solely by tests/*, never by shipping code. -->
  <ItemGroup>
    <!-- R13 well-formedness gate: strict-mode HTML parsing of rendered template
         output in the render engine's unit tests. -->
    <PackageVersion Include="AngleSharp" Version="1.6.0" />
    <!-- xUnit v3, which is Microsoft.Testing.Platform rather than VSTest: the v3
         packages depend on Microsoft.Testing.Platform and the .NET 10 SDK refuses
         to drive them through the VSTest target at all. So there is no
         Microsoft.NET.Test.Sdk and no xunit.runner.visualstudio pin here any more
         - both were dropped rather than bumped. Each test project sets
         OutputType=Exe (v3 errors without it) and `dotnet test` reaches them via
         the opt-in in global.json. -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <!-- The runner-less half of the same release, for a project that carries
         [Fact]s a CONSUMER runs rather than running them itself:
         libs/nativeweb.signin.testing. Referencing xunit.v3 there would demand an
         executable, which a packable library of abstract conformance suites
         cannot be. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.0" />
    <!-- Assert on its own, for the same project: the conformance suites assert,
         and extensibility.core carries the attributes and interfaces only. Both
         are plain libraries with no runner, which is the point. -->
    <PackageVersion Include="xunit.v3.assert" Version="4.0.0" />
    <!-- Integration tests: WebApplicationFactory host. Matched to the AspNetCore
         10.0.x line (no sibling pin exists to mirror). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
    <!-- The in-memory server behind tests/nativeweb.web.tests.unit (spec 015 T1).
         Mvc.Testing would drag WebApplicationFactory and an entry-point assembly
         in for a tier that composes its own pipeline; TestHost is the piece of it
         that matters here. Same 10.0.x line as the sibling pin above. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.7" />
    <!-- Property-based testing (spec 018). Generators plus shrinking, for the
         paging seam and the cursor codec: the 017 defects each lived in a
         combination of row count, null density, page size and cursor state that
         no example test enumerated, and a mutation run confirmed the gap before
         this was added. CsCheck rather than FsCheck because it is a plain C#
         API with no FSharp.Core dependency. -->
    <PackageVersion Include="CsCheck" Version="4.8.0" />
    <!-- End-to-end browser tests. Net-new to this repo (no sibling reference);
         pinned to a recent 1.x. -->
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.12.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.49.0" />
  </ItemGroup>

</Project>
