<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Test SDK/xUnit adapter pull in reflection-heavy paths that aren't
         trim/AOT-analyzed; these projects are never published, only run
         under the JIT via `dotnet test` (same convention as the sibling
         repos referenced in Directory.Build.props). -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <!-- CA1707 forbids underscores in identifiers; Method_Scenario_Expectation
         is the standard xUnit test-naming convention, not a naming defect. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\apps\web\nativeweb.web.csproj" />
    <!-- For AntiforgeryGuardAgreementTests only, which runs apps/web's antiforgery
         middleware and this library's UseAntiforgeryRejection through the same
         states and asserts they agree. The reference belongs HERE and not in
         apps/web: the two guards are duplicated on purpose (see the header of
         apps/web/Middleware/AntiforgeryValidationMiddleware.cs), and the whole
         point of that decision is that the identity provider does not depend on
         CRUD scaffolding. A test project may know about both without making the
         production dependency graph say something untrue. -->
    <ProjectReference Include="..\..\libs\nativeweb.scaffold\nativeweb.scaffold.csproj" />
  </ItemGroup>

</Project>
