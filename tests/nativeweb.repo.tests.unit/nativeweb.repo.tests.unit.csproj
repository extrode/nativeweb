<Project Sdk="Microsoft.NET.Sdk">

  <!-- Repository-level guards: the workflow files, nuget.config, the solution,
       Directory.Build.props, .editorconfig, the pack metadata and the skeleton's
       framework resolution. Every one of them asserts about a FILE rather than
       about a type, so this project references no production project at all and
       walks up to NativeWeb.slnx to find the repository root.

       It exists because these tests used to live in
       tests/nativeweb.web.tests.unit, which covered the identity provider and was
       deleted with it on 2026-08-31 (docs/decisions/2026-08-31-007-idp-leaves-nativeweb.md).
       None of them was ever about the identity provider; they were there because
       that was the repository's only unit tier. Housed on their own now, so the
       next thing to leave cannot take them with it. -->
  <PropertyGroup>
    <!-- Test SDK/xUnit adapter pull in reflection-heavy paths that aren't
         trim/AOT-analyzed; these projects are never published, only run
         under the JIT via `dotnet test`. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <!-- CA1707 forbids underscores in identifiers; Method_Scenario_Expectation
         is the standard xUnit test-naming convention, not a naming defect. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
