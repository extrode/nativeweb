<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NativeWeb.Forms.Tests.E2e</RootNamespace>
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <!-- Method_Scenario_Expectation is the xUnit convention, not a naming defect. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scaffolding e2e tier's process fixture, linked rather than copied, on the
         model of tests/nativeweb.permissions.tests.e2e. It publishes apps/sample,
         launches the binary, and holds the cross-process publish lock that keeps the
         e2e assemblies from overwriting a running image.

         Its BrowserFixture is NOT linked: that file also defines a collection over the
         scaffolding tier's own fixtures, and referencing it would start processes this
         tier has no use for. -->
    <Compile Include="..\nativeweb.scaffold.tests.e2e\SampleProcessFixture.cs"
             Link="SampleProcessFixture.cs" />
  </ItemGroup>

  <!-- No ProjectReference to apps/sample. This drives the published binary over a real
       socket, and a reference would only invite a test to reach past the browser into
       the upload directory. -->

</Project>
