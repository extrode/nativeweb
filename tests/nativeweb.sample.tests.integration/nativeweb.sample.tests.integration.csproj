<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NativeWeb.Sample.Tests.Integration</RootNamespace>
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <!-- Method_Scenario_Expectation is the xUnit convention, not a naming defect. -->
    <NoWarn>$(NoWarn);CA1707;CA1711</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reference application itself. The scaffolding tiers next door drive the
         same host for the generated admin; this one is the sample's own tier, and it
         exists because spec 016 R28 is a claim about the app rather than about any
         one library. -->
    <ProjectReference Include="..\..\apps\sample\nativeweb.sample.csproj" />
  </ItemGroup>

</Project>
