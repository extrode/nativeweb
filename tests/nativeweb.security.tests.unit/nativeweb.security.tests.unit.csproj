<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NativeWeb.Security.Tests.Unit</RootNamespace>
    <!-- Same test-project conventions as the sibling suites. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- HttpContext, the data protection stack and the DI container BotTraps
         resolves its protector, options and TimeProvider from. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\nativeweb.security\nativeweb.security.csproj" />
  </ItemGroup>

</Project>
