<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The smallest host that references the sign-in library, published NativeAOT so
       the trim and AOT analysers have something to walk (spec 016 R25).

       Not in NativeWeb.slnx on purpose. The gate beside it publishes this project by
       path, and a project the solution also builds would have its intermediates
       written by two processes at once: the same race SampleProcessFixture
       documents, where ILC fails on a locked .sourcelink several layers from
       anything that mentions parallelism.

       apps/sample would have served as the host: it references this library and it
       already publishes NativeAOT. It is not used, for the reason above and one
       more, a warning found there could belong to any of six libraries, and this
       gate is a claim about one. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <RootNamespace>NativeWeb.SignIn.Tests.Aot.ProbeHost</RootNamespace>
    <AssemblyName>probe-host</AssemblyName>
    <!-- The gate reads the warnings out of the log. Errors would stop the publish
         before the analysers had walked everything, and the report would be one
         warning long. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\libs\nativeweb.signin\nativeweb.signin.csproj" />
    <!-- Spec 024 T19. The permission layer joins the sign-in library here rather
         than getting a second AOT tier of its own: a NativeAOT publish is minutes,
         and one host referencing both is one publish instead of two. The generator
         is referenced as an analyzer, so PermissionCatalog and the model's own
         constants are emitted and the analysers walk them with the runtime
         library. -->
    <ProjectReference Include="..\..\..\libs\nativeweb.permissions\nativeweb.permissions.csproj" />
    <ProjectReference Include="..\..\..\libs\nativeweb.permissions.generator\nativeweb.permissions.generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
