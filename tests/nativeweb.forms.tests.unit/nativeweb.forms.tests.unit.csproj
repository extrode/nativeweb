<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NativeWeb.Forms.Tests.Unit</RootNamespace>
    <!-- Same test-project conventions as the sibling suites. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- HttpContext and IAntiforgeryMetadata, which the guards are built on. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- CSharpGeneratorDriver, to drive the form generator directly. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\nativeweb.forms\nativeweb.forms.csproj" />
    <!-- ReferenceOutputAssembly=true so the generator and the analyzer types are
         callable from the driver tests, same as the scaffold and render suites. -->
    <ProjectReference Include="..\..\libs\nativeweb.forms.generator\nativeweb.forms.generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
