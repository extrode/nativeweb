<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NativeWeb.Scaffold.Tests.Unit</RootNamespace>
    <!-- Same test-project conventions as the sibling suites. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- IAntiforgeryMetadata, which RequiresAntiforgery implements. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- CSharpGeneratorDriver, to drive the scaffold generator directly. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Generators and shrinking for the cursor codec's property tests. -->
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\nativeweb.scaffold\nativeweb.scaffold.csproj" />
    <!-- ReferenceOutputAssembly=true so the generator type itself is callable
         from the diagnostic and emitted-source tests, same as the render suite. -->
    <ProjectReference Include="..\..\libs\nativeweb.scaffold.generator\nativeweb.scaffold.generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
